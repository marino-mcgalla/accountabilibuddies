                    onTap: () => context.go(AppRoutesExtension.partyDetail(party.id)),
                  ),
                ).toList(),
              );
            },
            loading: () => const Padding(
              padding: EdgeInsets.all(32),
              child: Center(child: CircularProgressIndicator()),
