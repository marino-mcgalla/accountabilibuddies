              onPressed: () => context.go(AppRoutes.party),
              child: const Text('View All'),
            ),
          ],
        ),
        const SizedBox(height: 12),
        Card(
          child: partiesAsync.when(
            data: (parties) {
              if (parties.isEmpty) {
                return Padding(
                  padding: const EdgeInsets.all(16),
                  child: Column(
                    children: [
                      Icon(
