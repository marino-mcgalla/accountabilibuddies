        ),
        const SizedBox(height: 12),
        Card(
          child: partiesAsync.when(
            data: (parties) {
              if (parties.isEmpty) {
                return Padding(
                  padding: const EdgeInsets.all(16),
                  child: Column(
                    children: [
                      Icon(
                        Icons.event_busy,
                        size: 48,
                        color: Colors.grey[400],
                      ),
                      const SizedBox(height: 8),
                      Text(
                        'No active challenge',
                        style: Theme.of(context).textTheme.titleMedium?.copyWith(
                          color: Colors.grey[600],
                        ),
                      ),
                      const SizedBox(height: 4),
                      Text(
                        'Join a party to participate in challenges!',
                        style: Theme.of(context).textTheme.bodySmall?.copyWith(
                          color: Colors.grey[600],
                        ),
                        textAlign: TextAlign.center,
                      ),
                    ],
                  ),
                );
              }
              
              // Check all parties for active challenges
              return _ActiveChallengeDisplay(parties: parties);
            },
            loading: () => const Padding(
              padding: EdgeInsets.all(16),
              child: Center(child: CircularProgressIndicator()),
            ),
            error: (error, stack) => Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                children: [
                  Icon(
                    Icons.event_busy,
                    size: 48,
                    color: Colors.grey[400],
                  ),
                  const SizedBox(height: 8),
                  Text(
                    'No active challenge',
                    style: Theme.of(context).textTheme.titleMedium?.copyWith(
                      color: Colors.grey[600],
                    ),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    'Error loading challenges',
                    style: Theme.of(context).textTheme.bodySmall?.copyWith(
                      color: Colors.grey[600],
                    ),
                    textAlign: TextAlign.center,
                  ),
                ],
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildActiveGoalsSection(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Consumer(
          builder: (context, ref, child) {
            final activeTemplates = ref.watch(activeGoalTemplatesProvider);
            
            return Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  'Goal Templates (${activeTemplates.length})',
                  style: Theme.of(context).textTheme.headlineSmall,
                ),
                TextButton(
                  onPressed: () => context.go(AppRoutes.goals),
                  child: const Text('View All'),
                ),
              ],
            );
          },
        ),
        const SizedBox(height: 12),
        Consumer(
          builder: (context, ref, child) {
            final activeTemplates = ref.watch(activeGoalTemplatesProvider);
            
            if (activeTemplates.isEmpty) {
              return Card(
                child: Padding(
                  padding: const EdgeInsets.all(16),
                  child: Text(
                    'No goal templates yet. Create your first template to get started!',
                    style: Theme.of(context).textTheme.bodyMedium?.copyWith(
                      color: Colors.grey[600],
                    ),
                    textAlign: TextAlign.center,
                  ),
                ),
              );
            }
            
            return Column(
              children: activeTemplates.take(3).map((template) => 
                Padding(
                  padding: const EdgeInsets.only(bottom: 8),
                  child: _buildDashboardTemplateCard(context, template),
                )
              ).toList(),
            );
          },
        ),
      ],
    );
  }

  Widget _buildDashboardTemplateCard(BuildContext context, template.GoalTemplate goalTemplate) {
    return Card(
      child: ListTile(
        leading: CircleAvatar(
          backgroundColor: Theme.of(context).primaryColor,
          child: Icon(
            _getTemplateIcon(goalTemplate.category),
            color: Colors.white,
          ),
        ),
        title: Text(goalTemplate.title),
        subtitle: Text(
          '${goalTemplate.categoryDisplay} • ${goalTemplate.goalTypeDisplay}${goalTemplate.plannedFrequency != null ? ' • Planned: ${goalTemplate.plannedFrequency}/week' : ''}',
          style: TextStyle(color: Colors.grey[600]),
        ),
        trailing: IconButton(
          icon: const Icon(Icons.play_arrow),
          onPressed: () {
            // TODO: Navigate to create goal instance
          },
        ),
        onTap: () {
          // TODO: Navigate to template details
        },
      ),
    );
  }

